# Verdikt — environment template.
# Copy to .env and fill in. NEVER commit the real .env.

# ---- GenLayer connection -------------------------------------------------
# Network for contract deployment + frontend:
# studionet | testnet_asimov | testnet_bradbury | localnet
GENLAYER_NETWORK=studionet
GENLAYER_RPC=https://studio.genlayer.com/api
NEXT_PUBLIC_GENLAYER_RPC=https://studio.genlayer.com/api
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61999
NEXT_PUBLIC_GENLAYER_EXPLORER=https://explorer-studio.genlayer.com
NEXT_PUBLIC_GENLAYER_NETWORK=studionet

# Backend-funded wallet for deploys / judge-all helper (server-side ONLY).
# Generate a dedicated wallet; never reuse a personal one. Requires GEN.
BACKEND_PRIVATE_KEY=

# ---- Deployed contract (filled after deployment) ------------------------
VERDIKT_CONTRACT_ADDRESS=
NEXT_PUBLIC_VERDIKT_CONTRACT_ADDRESS=

# ---- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to true to serve seeded fake contests without the chain.
MOCK_MODE=true
# Optional WalletConnect project id for wallet modal.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
